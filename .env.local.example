# ============================================================
# Supabase configuration
# Copy this file to `.env.local` and fill in your values.
#
# Where to find them:
#   https://supabase.com/dashboard → your project →
#   Project URL: "Connect" button (top) or Settings → General
#   Key: API Keys → the PUBLISHABLE key (starts with sb_publishable_,
#        or the legacy "anon public" key on older projects)
#
# ⚠️ Never use the SECRET key in this app — it bypasses RLS.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=PASTE_YOUR_PROJECT_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_PUBLISHABLE_KEY_HERE

# Optional: the public URL of your site (used for canonical metadata).
# On Vercel this is your deployment URL, e.g. https://hbd-yourname.vercel.app
NEXT_PUBLIC_SITE_URL=